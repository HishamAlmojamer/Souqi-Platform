{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "devCommand": "expo",
  "cleanUrls": true,
  "framework": null,
  "rewrites": [
    {
      "source": "/:path((?!api/|_expo/|assets/|favicon\\.ico|metadata\\.json).*)",
      "destination": "/"
    }
  ]
}
