generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformAccountType {
  BUYER
  SUPPLIER

  @@map("platform_account_type")
}

enum OrganizationType {
  BUYER
  SUPPLIER

  @@map("organization_type")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED

  @@map("organization_status")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  QUALITY

  @@map("membership_role")
}

enum MembershipStatus {
  ACTIVE
  INACTIVE

  @@map("membership_status")
}

enum VerificationStatus {
  UNVERIFIED
  DRAFT
  SUBMITTED
  IN_REVIEW
  PENDING_AUDIT
  APPROVED
  AUDITED_SUPPLIER
  REJECTED
  SUSPENDED

  @@map("verification_status")
}

enum IndustrySchemaStatus {
  DRAFT
  PUBLISHED
  RETIRED

  @@map("industry_schema_status")
}

enum RFQStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED

  @@map("rfq_status")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED

  @@map("invitation_status")
}

enum QuoteStatus {
  DRAFT
  SUBMITTED
  SUPERSEDED
  WITHDRAWN
  LOST

  @@map("quote_status")
}

enum PurchaseOrderStatus {
  ACTIVE
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("purchase_order_status")
}

enum SampleStatus {
  REQUESTED
  QUOTED
  PAID
  IN_PRODUCTION
  IN_PREPARATION
  SHIPPED
  DELIVERED
  RECEIVED
  REVISION_REQUESTED
  REVISION_NEEDED
  APPROVED
  REJECTED

  @@map("sample_status")
}

enum MilestoneStatus {
  PENDING
  RAW_MATERIALS_READY
  IN_PRODUCTION
  ACTIVE
  QUALITY_CHECK
  PACKAGING
  READY_TO_SHIP
  DONE
  BLOCKED

  @@map("milestone_status")
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED

  @@map("scan_status")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED

  @@map("product_status")
}

enum ProductSource {
  CATALOG
  CUSTOM
  RFQ

  @@map("product_source")
}

enum InspectionKind {
  FACTORY_AUDIT
  PRE_SHIPMENT
  SAMPLE
  LABORATORY
  DOCUMENT

  @@map("inspection_kind")
}

enum InspectionReportStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  EXPIRED

  @@map("inspection_report_status")
}

enum MessageThreadType {
  PRODUCT
  RFQ
  QUOTE
  PURCHASE_ORDER
  SAMPLE
  INSPECTION
  ESCROW
  SHIPMENT
  SUPPORT

  @@map("message_thread_type")
}

enum MessageThreadStatus {
  OPEN
  CLOSED
  ARCHIVED

  @@map("message_thread_status")
}

enum EscrowHoldStatus {
  AWAITING_PAYMENT
  FUNDS_HELD_IN_ESCROW
  PARTIAL_RELEASED
  COMPLETED
  DISPUTED
  REFUNDED
  CANCELLED

  @@map("escrow_hold_status")
}

enum EscrowConditionKind {
  PRODUCTION_STARTED
  SAMPLE_APPROVED
  INSPECTION_APPROVED
  MILESTONE_DONE
  SHIPMENT_DELIVERED
  DOCUMENT_APPROVED
  MANUAL

  @@map("escrow_condition_kind")
}

enum EscrowConditionStatus {
  PENDING
  MET
  WAIVED

  @@map("escrow_condition_status")
}

enum EscrowLedgerEntryType {
  HOLD_CREATED
  CONDITION_MET
  PARTIAL_RELEASED
  RELEASED
  REFUNDED
  DISPUTED

  @@map("escrow_ledger_entry_type")
}

enum ShipmentStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  EXCEPTION

  @@map("shipment_status")
}

model PlatformAccount {
  id              String              @id @default(uuid()) @db.Uuid
  fullName        String              @map("full_name")
  companyName     String              @map("company_name")
  email           String              @unique
  passwordHash    String              @map("password_hash")
  accountType     PlatformAccountType @map("account_type")
  isPlatformAdmin Boolean             @default(false) @map("is_platform_admin")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships       Membership[]
  createdRfqs       Rfq[]           @relation("CreatedRFQs")
  createdPos        PurchaseOrder[] @relation("CreatedPurchaseOrders")
  decidedSamples    Sample[]        @relation("DecidedSamples")
  uploadedEvidence  EvidenceFile[]  @relation("UploadedEvidence")
  auditEvents       AuditEvent[]    @relation("ActorAuditEvents")
  refreshTokens     RefreshToken[]
  createdProducts   Product[]       @relation("CreatedProducts")
  uploadedRfqFiles  RfqAttachment[] @relation("UploadedRfqAttachments")
  verifiedReports   InspectionReport[] @relation("VerifiedInspectionReports")
  sentMessages      Message[]       @relation("SentMessages")
  readMessages      MessageRead[]   @relation("ReadMessages")
  createdEscrows    EscrowHold[]    @relation("CreatedEscrowHolds")
  metConditions     EscrowCondition[] @relation("MetEscrowConditions")
  escrowEntries     EscrowLedgerEntry[] @relation("EscrowLedgerActors")
  createdShipments  Shipment[]      @relation("CreatedShipments")
  notifications     Notification[]

  @@index([accountType])
  @@map("platform_accounts")
}

model Organization {
  id          String             @id @default(uuid()) @db.Uuid
  type        OrganizationType
  legalName   String             @map("legal_name")
  displayName String             @map("display_name")
  countryCode String             @map("country_code") @db.Char(2)
  status      OrganizationStatus @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships       Membership[]
  supplierProfile   SupplierProfile?
  buyerRfqs         Rfq[]            @relation("BuyerRFQs")
  supplierInvites   RfqInvitation[]  @relation("SupplierInvitations")
  quotes            Quote[]          @relation("SupplierQuotes")
  buyerPos          PurchaseOrder[]  @relation("BuyerPurchaseOrders")
  supplierPos       PurchaseOrder[]  @relation("SupplierPurchaseOrders")
  evidenceFiles     EvidenceFile[]   @relation("EvidenceFiles")
  auditEvents       AuditEvent[]     @relation("OrganizationAuditEvents")
  products          Product[]
  rfqAttachments    RfqAttachment[]  @relation("RfqAttachmentOrg")
  inspectionReports InspectionReport[] @relation("InspectionReportOrg")
  messageThreads    MessageThread[]  @relation("MessageThreadOrg")
  messages          Message[]        @relation("MessageSenderOrg")
  buyerEscrows      EscrowHold[]     @relation("BuyerEscrowHolds")
  supplierEscrows   EscrowHold[]     @relation("SupplierEscrowHolds")
  shipments         Shipment[]       @relation("ShipmentOrg")
  notifications     Notification[]

  @@index([type, status])
  @@map("organizations")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  accountId      String           @map("account_id") @db.Uuid
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      PlatformAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([organizationId, accountId])
  @@index([accountId, status])
  @@map("memberships")
}

model SupplierProfile {
  organizationId     String             @id @map("organization_id") @db.Uuid
  verificationStatus VerificationStatus @default(DRAFT) @map("verification_status")
  capabilities       Json?              @db.JsonB
  minOrderQuantity   Int?               @map("min_order_quantity")
  leadTimeDays       Int?               @map("lead_time_days")
  website            String?
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([verificationStatus])
  @@map("supplier_profiles")
}

model Industry {
  id     String  @id @default(uuid()) @db.Uuid
  code   String  @unique
  nameAr String  @map("name_ar")
  active Boolean @default(true)

  schemaVersions IndustrySchemaVersion[]
  rfqs           Rfq[]
  products       Product[]

  @@map("industries")
}

model IndustrySchemaVersion {
  id          String               @id @default(uuid()) @db.Uuid
  industryId  String               @map("industry_id") @db.Uuid
  version     Int
  schemaJson  Json                 @map("schema_json") @db.JsonB
  status      IndustrySchemaStatus @default(DRAFT)
  publishedAt DateTime?            @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  industry Industry @relation(fields: [industryId], references: [id], onDelete: Restrict)
  rfqs     Rfq[]

  @@unique([industryId, version])
  @@index([status])
  @@map("industry_schema_versions")
}

model Rfq {
  id                 String    @id @default(uuid()) @db.Uuid
  buyerOrgId         String    @map("buyer_org_id") @db.Uuid
  industryId         String    @map("industry_id") @db.Uuid
  schemaVersionId    String    @map("schema_version_id") @db.Uuid
  status             RFQStatus @default(DRAFT)
  title              String
  category           String?
  quantity           Int
  unit               String
  currency           String    @db.Char(3)
  targetUnitPriceCents BigInt? @map("target_unit_price_cents")
  incoterm           String?
  brandingRequirements String? @map("branding_requirements")
  destination        String
  targetDate         DateTime? @map("target_date") @db.Timestamptz(6)
  requirements       Json      @db.JsonB
  createdByAccountId String    @map("created_by_account_id") @db.Uuid
  publishedAt        DateTime? @map("published_at") @db.Timestamptz(6)
  closedAt           DateTime? @map("closed_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  buyerOrganization Organization          @relation("BuyerRFQs", fields: [buyerOrgId], references: [id], onDelete: Restrict)
  industry          Industry              @relation(fields: [industryId], references: [id], onDelete: Restrict)
  schemaVersion     IndustrySchemaVersion @relation(fields: [schemaVersionId], references: [id], onDelete: Restrict)
  createdBy         PlatformAccount       @relation("CreatedRFQs", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  invitations       RfqInvitation[]
  quotes            Quote[]
  purchaseOrder     PurchaseOrder?
  attachments       RfqAttachment[]
  messageThreads    MessageThread[]

  @@index([buyerOrgId, status, createdAt])
  @@index([industryId, status])
  @@index([schemaVersionId])
  @@map("rfqs")
}

model RfqInvitation {
  id            String           @id @default(uuid()) @db.Uuid
  rfqId         String           @map("rfq_id") @db.Uuid
  supplierOrgId String           @map("supplier_org_id") @db.Uuid
  status        InvitationStatus @default(PENDING)
  sentAt        DateTime         @default(now()) @map("sent_at") @db.Timestamptz(6)
  respondedAt   DateTime?        @map("responded_at") @db.Timestamptz(6)

  rfq         Rfq          @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierOrg Organization @relation("SupplierInvitations", fields: [supplierOrgId], references: [id], onDelete: Restrict)

  @@unique([rfqId, supplierOrgId])
  @@index([supplierOrgId, status])
  @@map("rfq_invitations")
}

model Quote {
  id            String      @id @default(uuid()) @db.Uuid
  rfqId         String      @map("rfq_id") @db.Uuid
  supplierOrgId String      @map("supplier_org_id") @db.Uuid
  revision      Int
  status        QuoteStatus @default(SUBMITTED)
  currency      String      @db.Char(3)
  leadTimeDays  Int         @map("lead_time_days")
  validUntil    DateTime    @map("valid_until") @db.Timestamptz(6)
  notes         String?
  submittedAt   DateTime    @default(now()) @map("submitted_at") @db.Timestamptz(6)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  rfq            Rfq             @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  supplierOrg    Organization    @relation("SupplierQuotes", fields: [supplierOrgId], references: [id], onDelete: Restrict)
  lines          QuoteLine[]
  purchaseOrders PurchaseOrder[]

  @@unique([rfqId, supplierOrgId, revision])
  @@index([rfqId, status])
  @@map("quotes")
}

model QuoteLine {
  id              String @id @default(uuid()) @db.Uuid
  quoteId         String @map("quote_id") @db.Uuid
  name            String
  quantity        Int
  unitPriceCents  BigInt @map("unit_price_cents")
  totalPriceCents BigInt @map("total_price_cents")
  sortOrder       Int    @default(0) @map("sort_order")

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, sortOrder])
  @@map("quote_lines")
}

model PurchaseOrder {
  id                  String              @id @default(uuid()) @db.Uuid
  rfqId               String              @unique @map("rfq_id") @db.Uuid
  quoteId             String              @map("quote_id") @db.Uuid
  buyerOrgId          String              @map("buyer_org_id") @db.Uuid
  supplierOrgId       String              @map("supplier_org_id") @db.Uuid
  status              PurchaseOrderStatus @default(ACTIVE)
  agreedTermsSnapshot Json                @map("agreed_terms_snapshot") @db.JsonB
  createdByAccountId  String              @map("created_by_account_id") @db.Uuid
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  rfq               Rfq                   @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  quote             Quote                 @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  buyerOrganization Organization          @relation("BuyerPurchaseOrders", fields: [buyerOrgId], references: [id], onDelete: Restrict)
  supplierOrg       Organization          @relation("SupplierPurchaseOrders", fields: [supplierOrgId], references: [id], onDelete: Restrict)
  createdBy         PlatformAccount       @relation("CreatedPurchaseOrders", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  samples           Sample[]
  milestones        ProductionMilestone[]
  evidenceFiles     EvidenceFile[]

  @@index([buyerOrgId, status])
  @@index([supplierOrgId, status])
  @@map("purchase_orders")
}

model Sample {
  id                 String       @id @default(uuid()) @db.Uuid
  purchaseOrderId    String       @map("purchase_order_id") @db.Uuid
  version            Int
  status             SampleStatus @default(REQUESTED)
  notes              String?
  shippedAt          DateTime?    @map("shipped_at") @db.Timestamptz(6)
  receivedAt         DateTime?    @map("received_at") @db.Timestamptz(6)
  decidedAt          DateTime?    @map("decided_at") @db.Timestamptz(6)
  decidedByAccountId String?      @map("decided_by_account_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  purchaseOrder PurchaseOrder    @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  decidedBy     PlatformAccount? @relation("DecidedSamples", fields: [decidedByAccountId], references: [id], onDelete: SetNull)

  @@unique([purchaseOrderId, version])
  @@index([status])
  @@map("samples")
}

model ProductionMilestone {
  id              String          @id @default(uuid()) @db.Uuid
  purchaseOrderId String          @map("purchase_order_id") @db.Uuid
  code            String
  sequence        Int
  status          MilestoneStatus @default(PENDING)
  plannedAt       DateTime?       @map("planned_at") @db.Timestamptz(6)
  completedAt     DateTime?       @map("completed_at") @db.Timestamptz(6)
  note            String?
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  evidenceFiles EvidenceFile[]

  @@unique([purchaseOrderId, code])
  @@index([purchaseOrderId, sequence])
  @@map("production_milestones")
}

model EvidenceFile {
  id                  String     @id @default(uuid()) @db.Uuid
  organizationId      String     @map("organization_id") @db.Uuid
  purchaseOrderId     String?    @map("purchase_order_id") @db.Uuid
  milestoneId         String?    @map("milestone_id") @db.Uuid
  objectKey           String     @map("object_key")
  checksum            String
  mimeType            String     @map("mime_type")
  sizeBytes           Int        @map("size_bytes")
  classification      String
  scanStatus          ScanStatus @default(PENDING) @map("scan_status")
  uploadedByAccountId String     @map("uploaded_by_account_id") @db.Uuid
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  organization  Organization         @relation("EvidenceFiles", fields: [organizationId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  milestone     ProductionMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  uploadedBy    PlatformAccount      @relation("UploadedEvidence", fields: [uploadedByAccountId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([purchaseOrderId])
  @@map("evidence_files")
}

model Product {
  id                 String        @id @default(uuid()) @db.Uuid
  supplierOrgId      String        @map("supplier_org_id") @db.Uuid
  industryId         String        @map("industry_id") @db.Uuid
  createdByAccountId String        @map("created_by_account_id") @db.Uuid
  sku                String?
  title              String
  description        String
  category           String
  source             ProductSource @default(CATALOG)
  status             ProductStatus @default(DRAFT)
  specifications     Json          @map("specifications") @db.JsonB
  unit               String
  currency           String        @db.Char(3)
  minOrderQuantity   Int?          @map("min_order_quantity")
  leadTimeDays       Int?          @map("lead_time_days")
  productionCapacity Int?          @map("production_capacity")
  certifications     String[]      @default([])
  priceCents         BigInt?       @map("price_cents")
  countryCode        String?       @map("country_code") @db.Char(2)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  supplierOrg Organization    @relation(fields: [supplierOrgId], references: [id], onDelete: Cascade)
  industry    Industry        @relation(fields: [industryId], references: [id], onDelete: Restrict)
  createdBy   PlatformAccount @relation("CreatedProducts", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  media       ProductMedia[]

  @@index([supplierOrgId, status])
  @@index([industryId, status])
  @@index([category])
  @@map("products")
}

model ProductMedia {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  objectKey String   @map("object_key")
  checksum  String
  mimeType  String   @map("mime_type")
  sizeBytes Int      @map("size_bytes")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_media")
}

model InspectionReport {
  id              String                 @id @default(uuid()) @db.Uuid
  organizationId  String                 @map("organization_id") @db.Uuid
  kind            InspectionKind
  status          InspectionReportStatus @default(DRAFT)
  issuer          String
  reportNumber    String?                @map("report_number")
  objectKey       String                 @map("object_key")
  checksum        String
  mimeType        String                 @map("mime_type")
  sizeBytes       Int                    @map("size_bytes")
  scope           String?
  summary         Json?                  @db.JsonB
  score           Int?
  issuedAt        DateTime?              @map("issued_at") @db.Timestamptz(6)
  expiresAt       DateTime?              @map("expires_at") @db.Timestamptz(6)
  reviewedAt      DateTime?              @map("reviewed_at") @db.Timestamptz(6)
  verifiedByAccountId String?            @map("verified_by_account_id") @db.Uuid
  notes           String?
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation("InspectionReportOrg", fields: [organizationId], references: [id], onDelete: Cascade)
  verifiedBy    PlatformAccount? @relation("VerifiedInspectionReports", fields: [verifiedByAccountId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([kind, status])
  @@index([expiresAt])
  @@map("inspection_reports")
}

model RfqAttachment {
  id                  String     @id @default(uuid()) @db.Uuid
  rfqId               String     @map("rfq_id") @db.Uuid
  organizationId      String     @map("organization_id") @db.Uuid
  uploadedByAccountId String     @map("uploaded_by_account_id") @db.Uuid
  label               String
  objectKey           String     @map("object_key")
  checksum            String
  mimeType            String     @map("mime_type")
  sizeBytes           Int        @map("size_bytes")
  classification      String
  confidentiality     String     @default("INVITED_SUPPLIERS")
  scanStatus          ScanStatus @default(PENDING) @map("scan_status")
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  rfq         Rfq             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  organization Organization    @relation("RfqAttachmentOrg", fields: [organizationId], references: [id], onDelete: Restrict)
  uploadedBy  PlatformAccount  @relation("UploadedRfqAttachments", fields: [uploadedByAccountId], references: [id], onDelete: Restrict)

  @@index([rfqId, createdAt])
  @@map("rfq_attachments")
}

model MessageThread {
  id            String             @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  type          MessageThreadType
  subject       String
  status        MessageThreadStatus @default(OPEN)
  rfqId         String?            @map("rfq_id") @db.Uuid
  quoteId       String?            @map("quote_id") @db.Uuid
  purchaseOrderId String?          @map("purchase_order_id") @db.Uuid
  sampleId      String?            @map("sample_id") @db.Uuid
  inspectionReportId String?       @map("inspection_report_id") @db.Uuid
  escrowHoldId  String?            @map("escrow_hold_id") @db.Uuid
  shipmentId    String?            @map("shipment_id") @db.Uuid
  participantOrgIds String[]       @default([]) @map("participant_org_ids")
  lastMessageAt DateTime           @default(now()) @map("last_message_at") @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation("MessageThreadOrg", fields: [organizationId], references: [id], onDelete: Cascade)
  rfq          Rfq?         @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  messages     Message[]
  reads        MessageRead[]

  @@index([organizationId, status, lastMessageAt])
  @@index([rfqId])
  @@index([purchaseOrderId])
  @@map("message_threads")
}

model Message {
  id              String   @id @default(uuid()) @db.Uuid
  threadId        String   @map("thread_id") @db.Uuid
  senderAccountId String   @map("sender_account_id") @db.Uuid
  senderOrgId     String   @map("sender_org_id") @db.Uuid
  body            String
  offerJson       Json?    @map("offer_json") @db.JsonB
  idempotencyKey  String?  @map("idempotency_key")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  editedAt        DateTime? @map("edited_at") @db.Timestamptz(6)

  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender    PlatformAccount @relation("SentMessages", fields: [senderAccountId], references: [id], onDelete: Restrict)
  senderOrg Organization @relation("MessageSenderOrg", fields: [senderOrgId], references: [id], onDelete: Restrict)
  reads     MessageRead[]

  @@unique([threadId, idempotencyKey])
  @@index([threadId, createdAt])
  @@map("messages")
}

model MessageRead {
  id        String   @id @default(uuid()) @db.Uuid
  threadId  String   @map("thread_id") @db.Uuid
  messageId String?  @map("message_id") @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  readAt    DateTime @default(now()) @map("read_at") @db.Timestamptz(6)

  thread  MessageThread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  message Message?        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  account PlatformAccount @relation("ReadMessages", fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([threadId, accountId])
  @@map("message_reads")
}

model EscrowHold {
  id                  String          @id @default(uuid()) @db.Uuid
  purchaseOrderId     String          @unique @map("purchase_order_id") @db.Uuid
  buyerOrgId          String          @map("buyer_org_id") @db.Uuid
  supplierOrgId       String          @map("supplier_org_id") @db.Uuid
  amountCents         BigInt          @map("amount_cents")
  currency            String          @db.Char(3)
  status              EscrowHoldStatus @default(AWAITING_PAYMENT)
  mode                String          @default("DEMO")
  idempotencyKey      String          @unique @map("idempotency_key")
  createdByAccountId  String          @map("created_by_account_id") @db.Uuid
  fundedAt            DateTime?       @map("funded_at") @db.Timestamptz(6)
  releasedAt          DateTime?       @map("released_at") @db.Timestamptz(6)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  buyerOrg   Organization    @relation("BuyerEscrowHolds", fields: [buyerOrgId], references: [id], onDelete: Restrict)
  supplierOrg Organization   @relation("SupplierEscrowHolds", fields: [supplierOrgId], references: [id], onDelete: Restrict)
  createdBy  PlatformAccount @relation("CreatedEscrowHolds", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  conditions EscrowCondition[]
  ledger     EscrowLedgerEntry[]

  @@index([buyerOrgId, status])
  @@index([supplierOrgId, status])
  @@map("escrow_holds")
}

model EscrowCondition {
  id                 String                 @id @default(uuid()) @db.Uuid
  escrowHoldId       String                 @map("escrow_hold_id") @db.Uuid
  kind               EscrowConditionKind
  status             EscrowConditionStatus  @default(PENDING)
  title              String
  description        String?
  percentage         Int
  targetResourceId   String?                @map("target_resource_id") @db.Uuid
  metAt              DateTime?              @map("met_at") @db.Timestamptz(6)
  metByAccountId     String?                @map("met_by_account_id") @db.Uuid
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  hold   EscrowHold      @relation(fields: [escrowHoldId], references: [id], onDelete: Cascade)
  metBy  PlatformAccount? @relation("MetEscrowConditions", fields: [metByAccountId], references: [id], onDelete: SetNull)

  @@index([escrowHoldId, status])
  @@map("escrow_conditions")
}

model EscrowLedgerEntry {
  id               String               @id @default(uuid()) @db.Uuid
  escrowHoldId     String               @map("escrow_hold_id") @db.Uuid
  type             EscrowLedgerEntryType
  amountCents      BigInt               @map("amount_cents")
  balanceAfterCents BigInt              @map("balance_after_cents")
  currency         String               @db.Char(3)
  idempotencyKey   String               @unique @map("idempotency_key")
  metadata         Json?                @db.JsonB
  actorAccountId   String?              @map("actor_account_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  hold  EscrowHold      @relation(fields: [escrowHoldId], references: [id], onDelete: Restrict)
  actor PlatformAccount? @relation("EscrowLedgerActors", fields: [actorAccountId], references: [id], onDelete: SetNull)

  @@index([escrowHoldId, createdAt])
  @@map("escrow_ledger_entries")
}

model Shipment {
  id                 String        @id @default(uuid()) @db.Uuid
  purchaseOrderId    String        @map("purchase_order_id") @db.Uuid
  organizationId     String        @map("organization_id") @db.Uuid
  createdByAccountId String        @map("created_by_account_id") @db.Uuid
  carrier            String?
  trackingNumber     String?       @map("tracking_number")
  status             ShipmentStatus @default(CREATED)
  origin             String?
  destination        String?
  documentObjectKey  String?       @map("document_object_key")
  shippedAt          DateTime?     @map("shipped_at") @db.Timestamptz(6)
  deliveredAt        DateTime?     @map("delivered_at") @db.Timestamptz(6)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization    @relation("ShipmentOrg", fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    PlatformAccount @relation("CreatedShipments", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  events       ShipmentEvent[]

  @@index([purchaseOrderId])
  @@index([trackingNumber])
  @@index([status])
  @@map("shipments")
}

model ShipmentEvent {
  id             String        @id @default(uuid()) @db.Uuid
  shipmentId     String        @map("shipment_id") @db.Uuid
  status         ShipmentStatus
  location       String?
  note           String?
  occurredAt     DateTime      @map("occurred_at") @db.Timestamptz(6)
  source         String        @default("MANUAL")
  idempotencyKey String        @unique @map("idempotency_key")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
  @@map("shipment_events")
}

model Notification {
  id             String   @id @default(uuid()) @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  kind           String
  title          String
  body           String
  href           String?
  readAt         DateTime? @map("read_at") @db.Timestamptz(6)
  dedupeKey      String?  @unique @map("dedupe_key")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  account      PlatformAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([accountId, readAt, createdAt])
  @@index([organizationId, createdAt])
  @@map("notifications")
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  actorAccountId String?  @map("actor_account_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String   @map("resource_id")
  metadata       Json?    @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor        PlatformAccount? @relation("ActorAuditEvents", fields: [actorAccountId], references: [id], onDelete: SetNull)
  organization Organization?    @relation("OrganizationAuditEvents", fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorAccountId, createdAt])
  @@map("audit_events")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  payload       Json      @db.JsonB
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  account   PlatformAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
