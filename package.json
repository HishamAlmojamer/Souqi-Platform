    "cors": "^2.8.6",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jose": "^6.2.17",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "~19.2.2",
    "dotenv": "^18.0.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "prisma": "^6.19.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "api:dev": "node --import tsx --watch server/index.ts",
    "api:start": "node --import tsx server/index.ts",
    "db:up": "docker compose up -d database",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "seed:admin": "node --import tsx scripts/seed-admin.ts",
    "seed:demo": "node --import tsx scripts/seed-demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test server/backend.test.ts",
    "lint": "expo lint",
    "build:vercel": "npx --yes prisma@6.19.0 generate && node -e \"const fs=require('fs');for(const p of ['.expo','node_modules/.cache/metro','node_modules/.cache/expo']){fs.rmSync(p,{recursive:true,force:true})}\" && expo export -p web"
  },
  "private": true
